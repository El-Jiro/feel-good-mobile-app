#:kivy 2.0 
#^ Esto no hace nada realmente, nomás es para que la extensión de Kivy no me marque error de sintaxis

#Creamos la primera pantalla y le ponemos el nombre "LoginScreen", deberá ir entre paréntesis angulares (<>)
#y llevar dos puntos (:) despúes del paréntesis de cierre
<LoginScreen>:
    #Antes de empezar a poner los widgets, definimos un Layout, que es como un contenedor invisible dentro del cual se acomodarán
    #todos los demás elementos, este ya no lleva los paréntesis, sólo los dos puntos
    GridLayout:
        cols:1 #Especificamos la cantidad de columnas con el atributo cols
        #Añadimos dos GridLayout extras para dividir los elementos de la interfaz gráfica en dos grupos, en este primero
        #colocaremos el formulario de incio de sesión
        GridLayout:
            cols:1
            #Añadimos un padding tanto horizontal como vertical, esto es la distancia entre los bordes del Layout y los de la pantalla
            padding: 15, 15 
            #El spacing es parecido, pero se refiere a la distancia entre los bordes de cada widget dentro del layout
            spacing: 20, 20
            Label:
                text: "Inicio de Sesión"
                #Aumentamos el tamaño de la fuente aquí, deberemos añadir sp (space-independent pixels) después del número
                font_size: "20sp"
                size_hint_y: None
                height: "40dp"
            TextInput:
                id: user
                #Para el texto fantasma que aparece dentro de los campos de texto usamos el atributo "hint_text"
                hint_text: "Nombre de usuario"
                size_hint_y: None
                height: "60dp"
            TextInput:
                id: pswd
                hint_text: "Contraseña"
                size_hint_y: None
                height: "60dp"
            RelativeLayout:
                size_hint_y: None
                height: "80dp"
                Button:
                    text: "Acceder"
                    #También podemos usar directamente los ids sin tener que acceder primero a root.ids 
                    on_press: root.login(user.text, pswd.text)
                    size_hint: 0.3, 0.5
                    #Con pos_hint podemos centrar el widget aplicando valores relativos a x e y
                    pos_hint: {'center_x': 0.5, 'center_y': 0.6}
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                BoxLayout:
                    orientation: "horizontal"
                    #width: self.minimum_width
                    size_hint: None, None
                    size: self.minimum_size
                    spacing: 5
                    CheckBox:
                        id: keep_session
                        size_hint: None, None
                        size: "30dp", "18dp"
                    Label:
                        text: "Recordarme"
                        size_hint: None, None
                        size: self.texture_size
        Label:
            id: wrong_login
            text: ""
            color: "red"
        GridLayout:
            #Añadimos dos botones: Uno para reestablecer la contraseña y otro para crear un cuenta si el usuario aún no está registrado
            cols: 2
            size_hint_y: None
            padding: 10, 10
            spacing: 10, 0
            height: "110dp"
            Button:
                text:"¿Olvidaste la contraseña?"
                on_press: root.go_to_forgot_password()
                #Ponemos el color de fondo totalmente transparente con un formato RGBA
                background_color: 1, 1, 1, 0
                #Si el botón está en su estado normal, es decir en reposo, la opacidad será de 1, pero al cambiar a pressed 
                #o released será de 0.5
                opacity: 1 if self.state == "normal" else 0.5
                #Cambiamos el color del texto por azul:
                color: 0.1, 0.7, 1, 1
            Button:
                text:"Registrarse"
                #Usamos el atributo on_press para llamar a una función cuando sea presionado, el atributo root se refiere a la clase 
                #que representa nuestro widget padre en el script de python, en este caso LoginScreen
                on_press: root.go_to_sign_up()
                #Ponemos el color de fondo totalmente transparente con un formato RGBA
                background_color: 1, 1, 1, 0
                #Si el botón está en su estado normal, es decir en reposo, la opacidad será de 1, pero al cambiar a pressed 
                #o released será de 0.5
                opacity: 1 if self.state == "normal" else 0.5
                #Cambiamos el color del texto por azul:
                color: 0.1, 0.7, 1, 1

<SignUpScreen>:
    GridLayout:
        cols: 1
        GridLayout:
            cols:1
            Label:
                text: "¡Registráte para un viaje espacial!"
            TextInput:
                #le añadimos un id a los TextInput para poder manipularlos en tiempo de ejecución, dicho id no debe ir entre comillas
                id: user
                hint_text: "Nuevo nombre de usuario"
            TextInput:
                id: pswd
                hint_text: "Nueva contraseña"
            Label:
                id: wrong_signup
                text: ""
                color: "red"
        GridLayout:
            cols: 2
            Button:
                text: "Enviar"
                #Utilizamos root.ids para acceder a nuestros widgets por medio de su id y los pasamos como argumentos de nuestro
                #método add_user. Deberemos poner .text después del id, de lo contrario imprimirá los objetos como tal en vez del
                #texto que contienen
                on_press: root.add_user(root.ids.user.text, root.ids.pswd.text)
            Button:
                text: "Regresar"
                on_press: root.login()

<MainScreen>:
    GridLayout:
        cols: 1
        Button:
            text: "Cerrar sesión"
            on_press: root.logout()
        Label:
            text: "¿Cómo te sientes hoy, " + root.user + "?"
        TextInput:
            id: feeling
            hint_text: "Intenta con: feliz, triste, no amado, etc."
        Button:
            text: "Ilumíname"
            on_press: root.get_quote(feeling.text)
        #Mostraremos una cita correspondiente al estado de ánimo del usuario en el label de abajo al presionar el botón
        Label:
            id: quote
            text: ""

<ForgotPasswordScreen>:
    GridLayout:
        cols: 1
        Label:
            text: "Reestablecer contraseña"
        TextInput:
            id: user
            hint_text: "Nombre de usuario"
        TextInput:
            id: pswd
            hint_text: "Nueva contraseña"
        Label:
            id: error_msg
            text: ""
            color: "red"
        GridLayout:
            cols:2
            Button:
                text: "Reestablecer"
                on_press: root.reset_password(user.text, pswd.text)
            Button:
                text: "Regresar"
                on_press: root.go_to_login()

#Añadimos otra regla llamada RootWidget, la cual se encargará de administrar todas las pantallas de la app
<RootWidget>:
    #Añadimos la pantalla que creamos arriba como un subelemento de root_widget:
    LoginScreen:
        #le damos un nombre para poder acceder a ella y manipularla desde el código Python
        name: "login_screen"
    #Añadimos la pantalla de registro de la misma forma
    SignUpScreen:
        name: "sign_up_screen"
    MainScreen:
        name: "main_screen"
    ForgotPasswordScreen:
        name: "forgot_password_screen"